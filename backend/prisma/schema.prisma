generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  ANALYZING
  READY
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AgentStatus {
  IDLE
  RUNNING
  PAUSED
  ERROR
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
  FAILED
  BLOCKED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  name          String
  passwordHash  String
  emailVerified Boolean              @default(false)
  createdAt     DateTime             @default(now())
  memberships   OrganizationMember[]
  projectRoles  ProjectMember[]

  @@map("users")
}

model Organization {
  id           String               @id @default(uuid())
  name         String
  industry     String?
  description  String?
  objectives   String?
  settings     Json                 @default("{}")
  createdAt    DateTime             @default(now())
  members      OrganizationMember[]
  departments  Department[]
  projects     Project[]
  agents       AiAgent[]
  tasks        Task[]
  workflows    Workflow[]
  documents    Document[]
  approvals    Approval[]
  integrations Integration[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents         AiAgent[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Project {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  description    String
  status         ProjectStatus   @default(DRAFT)
  analysis       Json?
  roles          Json?
  createdById    String?
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  agents         AiAgent[]
  tasks          Task[]
  workflows      Workflow[]
  documents      Document[]
  messages       AgentMessage[]
  approvals      Approval[]

  @@map("projects")
}

model ProjectMember {
  id        String  @id @default(uuid())
  projectId String
  userId    String
  role      OrgRole @default(MEMBER)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model AiAgent {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  departmentId   String?
  name           String
  roleName       String
  description    String?
  systemPrompt   String
  status         AgentStatus  @default(IDLE)
  config         Json         @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  skills         AgentSkill[]
  tools          AgentTool[]
  tasks          Task[]
  runs           AgentRun[]

  @@map("ai_agents")
}

model AgentSkill {
  id      String  @id @default(uuid())
  agentId String
  name    String
  agent   AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_skills")
}

model AgentTool {
  id        String  @id @default(uuid())
  agentId   String
  toolName  String
  permitted Boolean @default(true)
  agent     AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolName])
  @@map("agent_tools")
}

model Task {
  id              String           @id @default(uuid())
  organizationId  String
  projectId       String
  assignedAgentId String?
  title           String
  description     String
  phase           String?
  status          TaskStatus       @default(PENDING)
  priority        Int              @default(3)
  estimatedHours  Float?
  requiresApproval Boolean         @default(false)
  output          Json?
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedAgent   AiAgent?         @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  dependencies    TaskDependency[] @relation("TaskDeps")
  dependents      TaskDependency[] @relation("TaskDependents")
  runs            AgentRun[]
  approvals       Approval[]

  @@map("tasks")
}

model TaskDependency {
  id          String @id @default(uuid())
  taskId      String
  dependsOnId String
  task        Task   @relation("TaskDeps", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@map("task_dependencies")
}

model AgentMessage {
  id          String   @id @default(uuid())
  projectId   String
  fromAgentId String?
  toAgentId   String?
  taskId      String?
  kind        String   @default("message")
  content     String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("agent_messages")
}

model AgentRun {
  id         String    @id @default(uuid())
  agentId    String
  taskId     String
  status     String    @default("running")
  input      Json?
  output     Json?
  error      String?
  tokens     Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  agent      AiAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("agent_runs")
}

model Workflow {
  id             String         @id @default(uuid())
  organizationId String
  projectId      String
  name           String
  status         String         @default("DRAFT")
  definition     Json           @default("{}")
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps          WorkflowStep[]

  @@map("workflows")
}

model WorkflowStep {
  id         String   @id @default(uuid())
  workflowId String
  order      Int
  name       String
  type       String   @default("task")
  config     Json     @default("{}")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_steps")
}

model Document {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  title          String
  type           String
  content        String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Approval {
  id             String         @id @default(uuid())
  organizationId String
  projectId      String
  taskId         String?
  kind           String         @default("task_output")
  status         ApprovalStatus @default(PENDING)
  payload        Json?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("approvals")
}

model Integration {
  id             String       @id @default(uuid())
  organizationId String
  provider       String
  enabled        Boolean      @default(true)
  config         Json         @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("integrations")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  meta           Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
